[Unit]
Description=HEXA NFDUMP CGNAT LOGS (PHP built-in server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/opt/hexa-cgnat-logger
ExecStart=/usr/bin/php -S 0.0.0.0:8080 -t /var/opt/hexa-cgnat-logger /var/opt/hexa-cgnat-logger/index.php
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target